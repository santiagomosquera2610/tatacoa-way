{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/resena/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
